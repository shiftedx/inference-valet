+++ b/serve/test_malformed_diagnostics.py
@@ -0,0 +1,32 @@
+import unittest
+from serve.frontend import OutputParser
+class MalformedDiagnostics(unittest.TestCase):
+    tools = [{"name": "run_code", "parameters": {"properties": {"code": {"type": "string"}}}}]
+    def test_malformed_call_is_observable(self):
+        raw = "<tool_call>\n<function=run_code>\n<parameter=code\n</function>\n</tool_call>"
+        for width in (1, 4, len(raw)):
+            parser = OutputParser(thinking=False, tools=self.tools, recover=True)
+            events = []
+            for index in range(0, len(raw), width): events.extend(parser.feed(raw[index:index+width]))
+            events.extend(parser.finish())
+            self.assertFalse([event for event in events if event.kind == "tool_call"])
+            self.assertEqual(parser.unresolved_calls, 1)
+            self.assertEqual(parser.unresolved_names, ["run_code"])
+    def test_valid_call_has_no_false_rejection(self):
+        parser = OutputParser(thinking=False, tools=self.tools, recover=True)
+        raw = "<tool_call>\n<function=run_code>\n<parameter=code>print(1)</parameter>\n</function>\n</tool_call>"
+        events = parser.feed(raw) + parser.finish()
+        self.assertEqual(len([event for event in events if event.kind == "tool_call"]), 1)
+        self.assertEqual(parser.unresolved_calls, 0)
+        self.assertEqual(parser.unresolved_names, [])
+
+    def test_incomplete_announced_stream_is_counted_without_executing_it(self):
+        raw = "<tool_call>\n<function=run_code>\n<parameter=code>print(1)"
+        for width in (1, 4, len(raw)):
+            parser = OutputParser(thinking=False, tools=self.tools, recover=True, stream_tools=True)
+            events = []
+            for index in range(0, len(raw), width): events.extend(parser.feed(raw[index:index+width]))
+            events.extend(parser.finish(reason="length"))
+            self.assertFalse([event for event in events if event.kind == "tool_call"])
+            self.assertEqual(parser.unresolved_calls, 1)
+            self.assertEqual(parser.unresolved_names, ["run_code"])
